{
  "name": "lets-be-friends",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm --filter @lets-be-friends/web dev",
    "dev:web": "pnpm --filter @lets-be-friends/web dev:web",
    "dev:admin": "pnpm --filter @lets-be-friends/admin dev",
    "dev:mobile": "pnpm --filter @lets-be-friends/mobile dev",
    "dev:mobile:tunnel": "pnpm --filter @lets-be-friends/mobile dev:tunnel",
    "dev:all": "pnpm --parallel --filter @lets-be-friends/web --filter @lets-be-friends/admin dev",
    "build": "pnpm --filter @lets-be-friends/web --filter @lets-be-friends/admin --filter @lets-be-friends/mobile build",
    "test": "pnpm --filter @lets-be-friends/web --filter @lets-be-friends/admin --filter @lets-be-friends/mobile test",
    "typecheck": "pnpm --filter @lets-be-friends/web --filter @lets-be-friends/admin --filter @lets-be-friends/mobile typecheck",
    "convex:dev": "pnpm --filter @lets-be-friends/web convex:dev",
    "convex:codegen": "pnpm --filter @lets-be-friends/web convex:codegen",
    "seed:pampanga": "pnpm --filter @lets-be-friends/web seed:pampanga"
  },
  "devDependencies": {
    "pnpm": "^10.24.0",
    "youch": "^4.1.1",
    "youch-core": "^0.3.3"
  }
}
