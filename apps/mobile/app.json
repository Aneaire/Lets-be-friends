{
  "expo": {
    "name": "Let's Be Friends",
    "slug": "lets-be-friends",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "letsbefriends",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.letsbefriends.mobile"
    },
    "android": {
      "package": "com.letsbefriends.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "android": {
            "imageWidth": 140
          },
          "dark": {
            "backgroundColor": "#090909",
            "image": "./assets/images/splash-logo.png"
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon-monochrome.png",
          "color": "#000000",
          "defaultChannel": "account-updates"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Let's Be Friends to use your location once during onboarding. Only coordinates rounded to two decimals are saved."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Let's Be Friends to choose a profile photo, community post media, or optional private booking evidence.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a32cb8bc-1021-43b6-82ea-d5376ba33340"
      }
    },
    "owner": "gelogaming"
  }
}
