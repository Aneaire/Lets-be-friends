{
  "expo": {
    "name": "Let's Be Friends",
    "slug": "lets-be-friends",
    "version": "0.1.7",
    "orientation": "portrait",
    "icon": "./assets/images/official-app-icon.png",
    "scheme": "letsbefriends",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.letsbefriends.mobile",
      "associatedDomains": [
        "applinks:www.letsbefriends.space"
      ]
    },
    "android": {
      "package": "com.letsbefriends.mobile",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "www.letsbefriends.space",
              "pathPrefix": "/social"
            },
            {
              "scheme": "https",
              "host": "www.letsbefriends.space",
              "pathPrefix": "/companion-profile"
            },
            {
              "scheme": "https",
              "host": "www.letsbefriends.space",
              "pathPrefix": "/review"
            },
            {
              "scheme": "https",
              "host": "www.letsbefriends.space",
              "pathPrefix": "/circles"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/official-adaptive-foreground.png",
        "monochromeImage": "./assets/images/official-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/official-favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "android": {
            "imageWidth": 140
          },
          "dark": {
            "backgroundColor": "#090909",
            "image": "./assets/images/splash-logo.png"
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/official-notification-icon.png",
          "color": "#000000",
          "defaultChannel": "account-updates-v2"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Let's Be Friends to use your location once during onboarding. Only coordinates rounded to two decimals are saved."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Let's Be Friends to choose a profile photo, community post media, or optional private booking evidence.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Let's Be Friends to access your photos for profile and community images.",
          "savePhotosPermission": "Allow Let's Be Friends to save your QR Ph payment code to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec604d95-771b-4985-973c-4e7d89507e2c"
      }
    },
    "owner": "lets-be-friends"
  }
}
