{
  "name": "@lets-be-friends/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n convex,web -c magenta,cyan \"pnpm convex:dev\" \"pnpm dev:web\"",
    "dev:web": "PORT=3005 node --env-file=../../.env.local --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js --host localhost --port 3005 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "convex:dev": "node --env-file=../../.env.local --env-file-if-exists=.env.local ./node_modules/convex/bin/main.js dev",
    "convex:codegen": "convex codegen",
    "seed:pampanga": "node --env-file=../../.env.local --env-file-if-exists=.env.local ./node_modules/convex/bin/main.js run seeds:seedPampangaCompanions"
  },
  "dependencies": {
    "@clerk/react": "^6.6.1",
    "@clerk/tanstack-react-start": "^1.2.2",
    "@convex-dev/geospatial": "0.2.1",
    "@lets-be-friends/shared": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "convex": "^1.37.0",
    "lucide-react": "^0.545.0",
    "maplibre-gl": "^5.24.0",
    "nitro": "npm:nitro-nightly@latest",
    "persona": "^5.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.54",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
