# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
# Public Expo publishable key only. Never place the Clerk secret key in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWT_ISSUER_DOMAIN=

# Convex
CONVEX_URL=
CONVEX_HTTP_URL=
CONVEX_DEPLOY_KEY=
VITE_CONVEX_URL=
# Public Expo client URL only. Never place Convex deploy keys or other secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_CONVEX_URL=
# Optional public web app base URL for explicit mobile identity verification handoff only. Never include credentials, query text, fragments, or secrets.
EXPO_PUBLIC_WEB_APP_URL=
VITE_CONVEX_SITE_URL=

# Expo push delivery. Set only in the Convex server environment, never in EXPO_PUBLIC_*.
# Fail-closed: only the exact value true enables delivery.
EXPO_PUSH_ENABLED=false
EXPO_PROJECT_ID=
# Optional Expo enhanced push security access token.
EXPO_PUSH_ACCESS_TOKEN=
# Enable the lower-importance social Android channel only after the APK that
# creates the social-updates channel is live. Until then social pushes use the
# account-updates-v2 channel.
EXPO_SOCIAL_PUSH_CHANNEL_ENABLED=false

# Persona provider integration is dormant. Historical rows, eligibility, and
# legacy booking schema remain readable until the recorded expiry, but no new
# Persona inquiries or webhooks are processed.

# Optional overrides. Prefers IDENTITY_APPROVAL_TTL_DAYS, then the legacy
# PERSONA_VERIFICATION_TTL_DAYS fallback, then 730 days.
# IDENTITY_APPROVAL_TTL_DAYS=730

# In-app identity extraction (set these in the Convex deployment environment).
# Request Zero Data Retention for production if eligible. ID requests use store:false.
# The live selfie is stored privately by this app and is never sent to OpenAI.
# OPENAI_DECISION_MODEL drives the Decisions API reviewer signals. Only
# gpt-6-luna is supported while that endpoint is in public beta.
OPENAI_API_KEY=
OPENAI_IDENTITY_MODEL=gpt-5.6-luna
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_API_BASE_URL=https://api.openai.com/v1
# Identity image retention is account lifetime while the member account exists.
# The legacy IDENTITY_RECORD_RETENTION_DAYS upload TTL is deprecated and must
# not override the account lifetime promise. Do not reintroduce it.
# Identity approval expiry stays independent via IDENTITY_APPROVAL_TTL_DAYS.

# A reviewer signal below this probability is surfaced for manual checking.
# IDENTITY_ASSESSMENT_THRESHOLD=0.7

# Member-wallet v2 financial creation (set in the Convex deployment environment).
# Fail-closed: only the exact value true enables new member-wallet bookings and member top-ups.
# Reads, reconciliation, evidence retention, and settlement for existing v2 rows are never gated.
MEMBER_WALLET_V2_ENABLED=true

# PayMongo QR Ph top-ups (member booking wallet and retained legacy Companion fee balances).
# Set these in the Convex deployment environment. Secret/public keys and the webhook secret must all belong to PAYMONGO_MODE.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_PUBLIC_KEY=pk_test_
PAYMONGO_WEBHOOK_SECRET=

# Companion withdrawals from available earnings. Only the exact value true enables setup and requests.
# Generate the encryption key with: openssl rand -base64 32
# Keep the encryption key stable. Rotating it requires a deliberate payout-method re-encryption plan.
COMPANION_WITHDRAWALS_ENABLED=false
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
# Optional overrides
# PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
# PAYMONGO_API_BASE_URL=https://api.paymongo.com
# Optional per-transfer status callback for PayMongo batch transfers.
# Set this to the public HTTPS webhook URL in deployments that send withdrawals,
# for example https://your-convex-site.convex.site/paymongo/webhook.
# When unset, transfers rely on the Dashboard webhook subscription alone.
# PAYMONGO_TRANSFER_CALLBACK_URL=https://your-convex-site.convex.site/paymongo/webhook
