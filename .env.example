# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWT_ISSUER_DOMAIN=

# Convex
CONVEX_URL=
CONVEX_HTTP_URL=
CONVEX_DEPLOY_KEY=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Persona server integration (set these in the Convex deployment environment too).
# The selected production template must require government ID, live selfie/liveness,
# face match, document validity, and provider-extracted age of at least 18.
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=itmpl_
PERSONA_ENVIRONMENT_ID=env_
PERSONA_WEBHOOK_SECRET=
PERSONA_API_VERSION=2025-12-08

# Development only. Comma-separated Clerk user IDs allowed to toggle identity test bypass.
# Never set this on a production deployment.
IDENTITY_TEST_BYPASS_USER_IDS=
# Optional overrides
# PERSONA_API_BASE_URL=https://api.withpersona.com/api/v1
# PERSONA_WEBHOOK_TOLERANCE_SECONDS=300
# PERSONA_VERIFICATION_TTL_DAYS=730
# PERSONA_DASHBOARD_BASE_URL=https://app.withpersona.com/dashboard/inquiries

# Member-wallet v2 financial creation (set in the Convex deployment environment).
# Fail-closed: only the exact value true enables new member-wallet bookings and member top-ups.
# Reads, reconciliation, evidence retention, and settlement for existing v2 rows are never gated.
MEMBER_WALLET_V2_ENABLED=true

# Development/testing only. Enables the self-service test-balance control and must remain unset in production.
MEMBER_WALLET_TEST_CREDIT_ENABLED=false

# PayMongo QR Ph top-ups (member booking wallet and retained legacy host-fee balances).
# Set these in the Convex deployment environment. Secret/public keys and the webhook secret must all belong to PAYMONGO_MODE.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_PUBLIC_KEY=pk_test_
PAYMONGO_WEBHOOK_SECRET=
# Optional overrides
# PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
# PAYMONGO_API_BASE_URL=https://api.paymongo.com
